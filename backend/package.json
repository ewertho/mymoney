{
  "name": "mymoney-backend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "API do MyMoney: ciclos mensais, orçamento por categoria e virada de mês",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "check": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "express": "^5.2.1",
